{
  "manifest_version": 3,
  "name": "Alyssa Capture",
  "version": "0.1.0",
  "description": "Capture visible ad and landing page materials into Alyssa Swipe File.",
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://alyssa-creative-sop-app.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Alyssa Capture",
    "default_popup": "popup.html"
  }
}
